rules_version = '2';

// Mentor-owned PDF reports, at most 5 MiB per upload.
// Flow D outlines and Flow F minutes PDFs are checked against Firestore
// (cross-service rules: grant the permission prompted on first deploy).
service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isTeamOfTopic(topicId) {
      return request.auth != null && profile().role in ['leader', 'member']
        && topicId == profile().classId + '_' + profile().teamId;
    }
    function bookingParty(bookingId) {
      let b = firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
      return request.auth != null
        && ((profile().role == 'mentor' && b.mentorUid == request.auth.uid)
          || (profile().role in ['leader', 'member']
            && profile().classId == b.classId && profile().teamId == b.teamId));
    }

    match /reports/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && fileName.matches('^[A-Za-z0-9_-]+[.]pdf$')
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Flow D: topic outline (PDF/DOCX <= 10 MiB), uploaded by the team leader.
    match /topics/{topicId}/{fileName} {
      allow read: if isTeamOfTopic(topicId)
        || (request.auth != null
          && firestore.get(/databases/(default)/documents/topics/$(topicId)).data.mentorUid == request.auth.uid);
      allow create: if isTeamOfTopic(topicId) && profile().role == 'leader'
        && fileName.matches('^outline_[0-9]+[.](pdf|docx)$')
        && request.resource.contentType in ['application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024;
    }

    // Flow F: minutes PDF, only after the mentor signed the minutes.
    match /minutes/{bookingId}/{fileName} {
      allow read: if bookingParty(bookingId);
      allow create, update: if bookingParty(bookingId) && fileName == 'minutes.pdf'
        && firestore.get(/databases/(default)/documents/minutes/$(bookingId)).data.isSignedByMentor == true
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
